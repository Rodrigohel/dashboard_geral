# Porta em que o Portal escuta (o único serviço exposto publicamente via
# Cloudflare Tunnel — Rede e Interfone continuam só na rede local, o Portal
# é quem fala com eles por trás).
PORT=3000
CORS_ORIGIN=http://localhost:5175

# Gerados automaticamente pelo install.sh em produção — troque em .env real.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h
SQLITE_PATH=./data/portal.db

# Chave usada para criptografar em repouso: senha de cada controlador de
# acesso e credenciais de serviço dos gateways (Rede/Interfone). Nunca
# comitar o valor real; trocá-lo invalida tudo que já foi salvo.
CREDENTIALS_KEY=dev-credentials-key-change-me

# --- Gateway: painel de Rede (Debian_dashboard) ---
# URL do backend dele, acessível a partir desta máquina (rede local).
GATEWAY_REDE_BASE_URL=http://127.0.0.1:3002
# Pasta com o frontend já buildado (frontend/dist) desse painel, para o
# Portal servir em /apps/rede — deixe em branco para não embutir o frontend
# (nesse caso o módulo "Rede" só expõe a API via /gateway/rede).
GATEWAY_REDE_FRONTEND_DIST=

# --- Gateway: painel de Interfone (FreePBX_Asterisk) ---
GATEWAY_INTERFONE_BASE_URL=http://127.0.0.1:3001
GATEWAY_INTERFONE_FRONTEND_DIST=
